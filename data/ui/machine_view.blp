using Gtk 4.0;
using Adw 1;

template $MachinesMachineView: Adw.BreakpointBin {
  width-request: 300;
  height-request: 200;

  // Only the last breakpoint that matches applies, so the narrow one repeats the one-column
  // details.
  Adw.Breakpoint {
    condition ("max-width: 860sp")

    setters {
      details_clamp.maximum-size: 640;
      details_clamp.tightening-threshold: 400;
      details_columns.orientation: vertical;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 480sp")

    setters {
      view_toggle.visible: false;
      switcher_bar.reveal: true;
      details_clamp.maximum-size: 640;
      details_clamp.tightening-threshold: 400;
      details_columns.orientation: vertical;
      details_columns.margin-start: 12;
      details_columns.margin-end: 12;
    }
  }

  child: Adw.ToolbarView toolbar {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle title {};

      [start]
      Adw.ToggleGroup view_toggle {
        Adw.Toggle {
          name: "console";
          icon-name: "video-display-symbolic";
          tooltip: _("Console");
        }

        Adw.Toggle {
          name: "serial";
          icon-name: "utilities-terminal-symbolic";
          tooltip: _("Serial Console");
        }

        Adw.Toggle {
          name: "details";
          icon-name: "document-properties-symbolic";
          tooltip: _("Details");
        }
      }

      [end]
      MenuButton {
        icon-name: "view-more-symbolic";
        menu-model: machine_menu;
        tooltip-text: _("Machine Menu");
      }

      [end]
      MenuButton power_button {
        icon-name: "system-shutdown-symbolic";
        menu-model: power_menu;
        tooltip-text: _("Power");
      }

      [end]
      Button start_button {
        icon-name: "media-playback-start-symbolic";
        tooltip-text: _("Start");
        action-name: "machine.start";
      }

      [end]
      Button fullscreen_button {
        icon-name: "view-fullscreen-symbolic";
        tooltip-text: _("Fullscreen");
        action-name: "machine.fullscreen";
      }
    }

    [bottom]
    Adw.ViewSwitcherBar switcher_bar {
      stack: view_stack;
    }

    content: Adw.ViewStack view_stack {
      vexpand: true;

      Adw.ViewStackPage {
        name: "console";
        title: _("Console");
        icon-name: "video-display-symbolic";

        child: Stack console_place {
          StackPage {
            name: "here";

            child: Adw.Bin console_bin {
              child: Overlay console_overlay {
                child: Stack console_stack {
                  transition-type: crossfade;

                  StackPage {
                    name: "display";

                    child: $MachinesConsole console {
                      hexpand: true;
                      vexpand: true;
                    };
                  }

                  StackPage {
                    name: "connecting";

                    child: Adw.Spinner {
                      halign: center;
                      valign: center;
                      width-request: 32;
                      height-request: 32;
                    };
                  }

                  StackPage {
                    name: "message";

                    child: Adw.StatusPage console_message {
                      child: Button console_button {
                        use-underline: true;
                        halign: center;

                        styles [
                          "pill",
                          "suggested-action",
                        ]
                      };
                    };
                  }
                };

                [overlay]
                Revealer grab_hint {
                  halign: center;
                  valign: start;
                  margin-top: 12;
                  transition-type: crossfade;
                  can-target: false;

                  child: Label {
                    label: _("Press Ctrl+Alt to release the keyboard");

                    styles [
                      "osd",
                      "console-osd",
                    ]
                  };
                }

                [overlay]
                Revealer console_controls {
                  halign: center;
                  valign: start;
                  transition-type: slide_down;

                  child: Box {
                    margin-top: 6;
                    spacing: 6;

                    styles [
                      "osd",
                      "toolbar",
                      "console-osd",
                    ]

                    Label controls_title {
                      margin-start: 6;
                      margin-end: 6;
                      ellipsize: end;
                      max-width-chars: 30;

                      styles [
                        "heading",
                      ]
                    }

                    MenuButton {
                      icon-name: "input-keyboard-symbolic";
                      focus-on-click: false;
                      tooltip-text: _("Send Key");
                      menu-model: send_keys_menu;
                    }

                    Button leave_fullscreen_button {
                      icon-name: "view-restore-symbolic";
                      tooltip-text: _("Leave Fullscreen");
                      focus-on-click: false;
                    }
                  };
                }
              };
            };
          }

          StackPage {
            name: "away";

            child: Adw.StatusPage {
              icon-name: "window-new-symbolic";
              title: _("Display in Its Own Window");

              child: Button {
                label: _("_Bring Back");
                use-underline: true;
                halign: center;
                action-name: "machine.attach-console";

                styles [
                  "pill",
                ]
              };
            };
          }
        };
      }

      Adw.ViewStackPage serial_page {
        name: "serial";
        title: _("Serial");
        icon-name: "utilities-terminal-symbolic";

        child: Stack serial_stack {
          StackPage {
            name: "terminal";
            child: Overlay {
              child: Adw.Bin serial_bin {};

              [overlay]
              Label serial_hint {
                label: _("Nothing received yet. The guest may not use its serial port.");
                wrap: true;
                justify: center;
                halign: center;
                valign: center;
                margin-start: 12;
                margin-end: 12;
                can-target: false;

                styles [
                  "serial-hint",
                  "dim-label",
                ]
              }
            };
          }

          StackPage {
            name: "message";

            child: Adw.StatusPage serial_message {
              child: Button serial_button {
                use-underline: true;
                halign: center;

                styles [
                  "pill",
                  "suggested-action",
                ]
              };
            };
          }
        };
      }

      Adw.ViewStackPage {
        name: "details";
        title: _("Details");
        icon-name: "document-properties-symbolic";

        child: ScrolledWindow details_scroller {
          hscrollbar-policy: never;

          child: Adw.Clamp details_clamp {
            maximum-size: 1240;
            tightening-threshold: 1000;

            child: Box details_columns {
              homogeneous: true;
              spacing: 24;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 24;
              margin-end: 24;

              Box details_start {
                orientation: vertical;
                spacing: 24;
                valign: start;
              }

              Box details_end {
                orientation: vertical;
                spacing: 24;
                valign: start;
              }
            };
          };
        };
      }
    };
  };
}

menu power_menu {
  section {
    item {
      label: _("_Resume");
      action: "machine.resume";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Pause");
      action: "machine.pause";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Sa_ve");
      action: "machine.save";
    }
  }

  section {
    item {
      label: _("_Shut Down");
      action: "machine.shut-down";
    }

    item {
      label: _("_Reboot");
      action: "machine.reboot";
    }
  }

  section {
    item {
      label: _("Force _Reset…");
      action: "machine.reset";
    }

    item {
      label: _("Force _Off…");
      action: "machine.force-off";
    }
  }
}

menu machine_menu {
  section {
    item {
      label: _("_Fullscreen");
      action: "machine.fullscreen";
    }

    item {
      label: _("Open Display in New _Window");
      action: "machine.detach-console";
    }

    item {
      label: _("Take _Screenshot…");
      action: "machine.screenshot";
    }
  }

  section {
    item {
      label: _("_USB Devices…");
      action: "machine.usb-devices";
    }

    item {
      label: _("_Redirect USB Devices…");
      action: "machine.redirect-usb";
    }

    submenu send_keys_menu {
      label: _("Send _Key");

      item {
        label: C_("shortcut", "Ctrl+Alt+Del");
        action: "console.send-keys";
        target: "ctrl-alt-delete";
      }

      item {
        label: C_("shortcut", "Ctrl+Alt+Backspace");
        action: "console.send-keys";
        target: "ctrl-alt-backspace";
      }

      item {
        label: C_("shortcut", "Ctrl+Alt+F1");
        action: "console.send-keys";
        target: "ctrl-alt-f1";
      }

      item {
        label: C_("shortcut", "Ctrl+Alt+F2");
        action: "console.send-keys";
        target: "ctrl-alt-f2";
      }

      item {
        label: C_("shortcut", "Ctrl+Alt+F7");
        action: "console.send-keys";
        target: "ctrl-alt-f7";
      }
    }
  }

  section {
    item {
      label: _("_Advanced Settings");
      action: "details.show-advanced-settings";
    }
  }

  section {
    item {
      label: _("Re_name…");
      action: "machine.rename";
    }

    item {
      label: _("_Clone…");
      action: "machine.clone";
    }

    item {
      label: _("Edit _XML…");
      action: "machine.edit-xml";
    }

    item {
      label: _("Discard _Saved State…");
      action: "machine.discard-saved";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Delete…");
      action: "machine.delete";
    }
  }
}
